@model List<FirstWebMVC.Models.Entities.Student>

<h2>Danh sách sinh viên</h2>

<a asp-action="Create">Thêm</a>

<table border="1">
    <tr>
        <th>Tên</th>
        <th>Tuổi</th>
        <th>Email</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
    }
</table>